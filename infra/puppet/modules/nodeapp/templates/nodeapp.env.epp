<%- | Hash $config | -%>
# Auto-generated by Puppet — DO NOT EDIT MANUALLY
# Manual edits will be reverted on next Puppet run (config drift = past incident cause)
NODE_ENV=<%= $config['node_env'] %>
PORT=<%= $config['port'] %>
DB_HOST=<%= $config['db_host'] %>
DB_NAME=<%= $config['db_name'] %>
LOG_LEVEL=<%= $config['log_level'] %>
SESSION_SECRET_KEY_VAULT_REF=<%= $config['session_secret_key_vault_ref'] %>
FEATURE_FLAG_NEW_CHECKOUT=<%= $config['feature_flag_new_checkout'] %>
